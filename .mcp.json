{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ]
        },
        "serena": {
            "type": "http",
            "url": "http://localhost:9121/mcp"
        },
        "context7": {
            "command": "pnpm",
            "args": [
                "dlx",
                "@upstash/context7-mcp"
            ]
        },
        "shadcn": {
            "command": "pnpm",
            "args": [
                "dlx",
                "shadcn-vue@latest",
                "mcp"
            ]
        }
    }
}