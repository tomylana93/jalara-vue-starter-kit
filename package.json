{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24 <25",
        "pnpm": ">=11 <12"
    },
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lang:export": "php artisan lang:export",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "test:frontend": "node --experimental-strip-types --test 'tests/Frontend/**/*.test.ts'",
        "test:ssr": "node tests/Frontend/ssr-render-smoke.mjs",
        "types:check": "vue-tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.7",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.13.3",
        "@typescript-eslint/parser": "^8.65.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/compiler-dom": "^3.5.40",
        "@vue/compiler-sfc": "^3.5.40",
        "@vue/eslint-config-typescript": "^14.9.0",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-vue": "^10.10.0",
        "playwright": "^1.62.0",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.1.5",
        "vue-eslint-parser": "10.4.1",
        "vue-tsc": "^2.2.4"
    },
    "dependencies": {
        "@inertiajs/vite": "^3.6.1",
        "@inertiajs/vue3": "^3.6.1",
        "@laravel/passkeys": "^0.2.0",
        "@lucide/vue": "^1.27.0",
        "@vueuse/core": "^14.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "filepond": "^4.32.12",
        "filepond-plugin-file-poster": "^2.5.2",
        "filepond-plugin-image-preview": "^4.6.12",
        "laravel-vite-plugin": "^3.1.3",
        "reka-ui": "^2.10.1",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.2.5",
        "vue": "^3.5.40",
        "vue-input-otp": "^0.3.2",
        "vue-sonner": "^2.0.9"
    },
    "optionalDependencies": {
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
        "lightningcss-linux-x64-gnu": "^1.33.0",
        "lightningcss-win32-x64-msvc": "^1.33.0"
    }
}
